{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "exclude": [
    "test",
    "src/effect/instance-context.ts",
    "src/file/time.ts",
    "src/filesystem/index.ts",
    "src/lsp/index.ts",
    "src/provider/sdk/copilot",
    "src/provider/sdk/openai-compatible",
    "src/session/index.ts",
    "src/server/error.ts",
    "src/tool/batch.ts",
    "src/tool/bash.ts",
    "src/tool/codesearch.ts",
    "src/tool/ls.ts",
    "src/tool/multiedit.ts"
  ]
}
