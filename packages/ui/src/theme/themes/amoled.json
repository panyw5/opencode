{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "AMOLED",
  "id": "amoled",
  "light": {
    "palette": {
      "neutral": "#f0f0f0",
      "ink": "#0a0a0a",
      "primary": "#6200ff",
      "accent": "#ff0080",
      "success": "#00e676",
      "warning": "#ffab00",
      "error": "#ff1744",
      "info": "#00b0ff",
      "diffAdd": "#00e676",
      "diffDelete": "#ff1744"
    },
    "surfaces": {
      "shell": "#ededed",
      "canvas": "#fafafa",
      "raised": "#ffffff",
      "inset": "#e2e2e2"
    },
    "overrides": {
      "syntax-comment": "#696969",
      "syntax-keyword": "#9d4bb0",
      "syntax-string": "#167a3f",
      "syntax-primitive": "#1c70a0",
      "syntax-property": "#9b5913",
      "syntax-constant": "#5c4ebe"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#000000",
      "ink": "#ffffff",
      "primary": "#b388ff",
      "accent": "#ff4081",
      "success": "#00ff88",
      "warning": "#ffea00",
      "error": "#ff1744",
      "info": "#18ffff",
      "diffAdd": "#00ff88",
      "diffDelete": "#ff1744"
    },
    "surfaces": {
      "shell": "#000000",
      "canvas": "#080808",
      "raised": "#191919",
      "inset": "#000000"
    },
    "overrides": {
      "syntax-comment": "#555555",
      "syntax-keyword": "#cf7ccc",
      "syntax-string": "#85f2a7",
      "syntax-primitive": "#3bfefd",
      "syntax-property": "#f8ea6e",
      "syntax-constant": "#b08ef1"
    }
  }
}
