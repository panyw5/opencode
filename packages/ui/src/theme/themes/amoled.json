  "light": {
    "palette": {
      "neutral": "#f0f0f0",
      "ink": "#0a0a0a",
      "primary": "#5c54af",
      "accent": "#d16586",
      "success": "#75db93",
      "warning": "#f4b04a",
      "error": "#d36466",
      "info": "#3daff3",
      "diffAdd": "#75db93",
      "diffDelete": "#d36466"
