{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/extension-kit",
  "version": "1.18.65",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    "./web": {
      "types": "./src/web.ts",
      "development": "./src/web.ts",
      "default": "./src/web.ts"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "development": "./src/rpc.ts",
      "default": "./src/rpc.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "development": "./vite.js",
      "default": "./vite.js"
    }
  },
  "files": [
    "dist",
    "src",
    "vite.js",
    "vite.d.ts",
    "shims.js",
    "shims.d.ts",
    "scope.js",
    "scope.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "prepack": "bun ./script/pack.ts --apply",
    "postpack": "bun ./script/pack.ts --restore",
    "typecheck": "tsgo --noEmit",
    "test": "bun --conditions=browser test test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0",
    "solid-js": "~1.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
