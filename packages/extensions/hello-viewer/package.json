{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/hello-viewer-extension",
  "version": "1.18.64",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./web": "./dist/web/index.js",
    "./server": "./dist/server.js"
  },
  "opencode": {
    "manifestVersion": 1,
    "id": "example.hello-viewer",
    "displayName": "Hello Viewer",
    "description": "Example extension: lazy-loaded .hello viewer with a server part (RPC, events, one LLM tool).",
    "web": {
      "apiVersion": 1,
      "styles": ["./dist/web/index.css"]
    },
    "activation": ["onFileViewer:hello"],
    "contributes": {
      "fileViewers": [
        {
          "id": "hello",
          "title": "Hello Viewer",
          "extensions": ["hello"],
          "priority": 100,
          "mode": "replace"
        }
      ]
    },
    "permissions": ["fs:read", "process:spawn", "tools"]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && bun run build:server",
    "build:server": "bun build src/server.ts --outfile dist/server.js --target=node --format=esm",
    "typecheck": "tsgo --noEmit",
    "test": "bun test test"
  },
  "dependencies": {
    "@opencode-ai/extension-kit": "workspace:*",
    "@opencode-ai/plugin": "workspace:*"
  },
  "devDependencies": {
    "@opencode-ai/ui": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@typescript/native-preview": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
