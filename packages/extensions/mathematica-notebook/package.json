{
  "name": "@opencode-ai/mathematica-notebook-extension",
  "version": "1.18.65",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./web": "./dist/web/index.js",
    "./server": "./dist/server.js"
  },
  "opencode": {
    "manifestVersion": 1,
    "id": "local.mathematica-notebook",
    "displayName": "Mathematica Notebook",
    "description": "Preview, edit and evaluate Wolfram notebooks with a shared agent-accessible kernel.",
    "web": {
      "apiVersion": 1,
      "styles": [
        "./dist/web/index.css"
      ]
    },
    "activation": [
      "onFileViewer:mathematica-notebook"
    ],
    "contributes": {
      "fileViewers": [
        {
          "id": "mathematica-notebook",
          "title": "Mathematica Notebook",
          "extensions": [
            "nb"
          ],
          "priority": 100,
          "mode": "replace",
          "content": "self"
        }
      ],
      "settings": {
        "wolframscriptPath": {
          "type": "string",
          "title": "wolframscript path",
          "default": "wolframscript"
        },
        "timeoutSeconds": {
          "type": "number",
          "title": "Cell evaluation timeout (seconds)",
          "default": 60
        },
        "maxKernels": {
          "type": "number",
          "title": "Maximum open notebook kernels",
          "default": 2
        },
        "exposeTool": {
          "type": "string",
          "title": "Agent notebook access",
          "enum": [
            "always",
            "never"
          ],
          "default": "always"
        }
      }
    },
    "permissions": [
      "process:spawn"
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && bun run build:server",
    "build:server": "bun build src/server.ts --outfile dist/server.js --target=node --format=esm && bun build src/preview-worker.ts --outfile dist/preview-worker.js --target=node --format=esm && cp src/bridge.wls dist/bridge.wls",
    "typecheck": "tsgo --noEmit",
    "test": "bun test test"
  },
  "devDependencies": {
    "@opencode-ai/extension-kit": "workspace:*",
    "@opencode-ai/plugin": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@typescript/native-preview": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "virtua": "catalog:"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
